{
  "rules": {
    ".read": false,
    ".write": false,
    "lobby": {
      ".read": "auth != null",
      "$host": {
        ".write": "auth != null && ((auth.uid === $host && (!data.exists() || !newData.exists())) || (!newData.exists() && !data.child('guest').exists() && data.child('createdAt').val() < now - 900000))",
        ".validate": "newData.hasChildren(['hostName', 'speed', 'animations', 'createdAt'])",
        "hostName": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
        },
        "speed": {
          ".validate": "newData.val() === 'easy' || newData.val() === 'normal' || newData.val() === 'hard'"
        },
        "animations": {
          ".validate": "newData.isBoolean()"
        },
        "createdAt": {
          ".validate": "newData.val() === now"
        },
        "guest": {
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && auth.uid !== $host && root.child('lobby').child($host).child('hostName').exists()) || (data.child('uid').val() === auth.uid && !newData.exists()))",
          ".validate": "newData.hasChildren(['uid', 'name'])",
          "uid": {
            ".validate": "newData.isString()"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "match": {
      "$host": {
        ".read": "auth != null && (auth.uid === $host || root.child('lobby').child($host).child('guest').child('uid').val() === auth.uid)",
        ".write": "auth != null && auth.uid === $host && !newData.exists()",
        "$player": {
          ".write": "auth != null && auth.uid === $player && ($player === $host || root.child('lobby').child($host).child('guest').child('uid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['snake', 'food', 'kind', 'score', 'status', 'left', 'forfeit'])",
          "snake": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1700"
          },
          "food": {
            ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() < 400"
          },
          "kind": {
            ".validate": "newData.val() === 'apple' || newData.val() === 'cherry' || newData.val() === 'orange' || newData.val() === 'banana' || newData.val() === 'strawberry' || newData.val() === 'grapes'"
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 400 && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() + 2 : 0)"
          },
          "status": {
            ".validate": "newData.val() === 'running' || newData.val() === 'gameOver' || newData.val() === 'won'"
          },
          "left": {
            ".validate": "newData.isBoolean()"
          },
          "forfeit": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
